{
  "name": "vexdyn-backend",
  "version": "1.0.0",
  "private": true,
  "description": "VEXDYN shared authentication backend (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply vexdyn-auth --local",
    "migrate:remote": "wrangler d1 migrations apply vexdyn-auth --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
